#include "malloc.h"
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <sys/mman.h>
#include <unistd.h>

#include <assert.h>

#define ALIGNMENT _Alignof(max_align_t)
#define IS_ALIGNED(size) ((size) % ALIGNMENT == 0)
#define ALIGN(size) (((size) + (ALIGNMENT - 1)) & ~(ALIGNMENT - 1))

#define PAGE_SIZE sysconf(_SC_PAGESIZE) * 4
#define MAX_BLOCK_SIZE (size_t)PAGE_SIZE
#define MIN_BLOCK_SIZE                                                         \
	(size_t)ALIGN(sizeof(t_free_block) + sizeof(t_block_footer))

static const size_t block_free_bit = 0x1;

// struct s_block_header {
// 	size_t size;
// } __attribute__((aligned(ALIGNMENT)));
// typedef struct s_block_header t_block_header;
// typedef struct s_block_header t_block_footer;
// typedef struct s_block_header t_block;

union s_block_header {
	size_t size;
	union s_block_header *next;
} __attribute__((aligned(ALIGNMENT)));
typedef union s_block_header t_block_header;
typedef union s_block_header t_block_footer;
typedef union s_block_header t_block;

struct s_free_block {
	size_t size;
	struct s_free_block *next;
	struct s_free_block *prev;
} __attribute__((aligned(ALIGNMENT)));
typedef struct s_free_block t_free_block;

struct s_heap {
	t_block_header *head;
	t_free_block *free_list;
	size_t size;
};
typedef struct s_heap t_heap;

static inline bool is_free_block(void *block)
{
	return ((t_block *)block)->size & block_free_bit;
}

static inline void set_free_block(void *block)
{
	((t_block *)block)->size |= block_free_bit;
}

static inline void set_alloc_block(void *block)
{
	((t_block *)block)->size &= ~block_free_bit;
}

static inline size_t block_size(void *block)
{
	return ((t_block *)block)->size & ~block_free_bit;
}

/*
 *  get the payload from the header
 * */
static inline void *get_payload(void *block)
{
	return (void *)((char *)block + sizeof(t_block));
}

/*
 *  get the footer from header
 *  */
static inline t_block *get_footer(void *block)
{
	return (t_block *)((char *)block + block_size(block) - sizeof(t_block));
}

/*
 *  get the header from footer
 * */
static inline t_block *get_header_from_footer(void *block)
{
	return (t_block *)((char *)block - block_size(block) + sizeof(t_block));
}

/*
 *  get the payload from the header
 * */
static inline t_block *get_header_from_payload(void *payload)
{
	return (t_block *)((char *)payload - sizeof(t_block));
}

/*
 *  get the header of the next block
 * */
static inline t_block *next_block(void *block)
{
	return (t_block *)((char *)block + block_size(block));
}

/*
 *  get the footer of the previous block
 * */
static inline t_block *prev_block(void *block)
{
	return (t_block *)((char *)block - sizeof(t_block));
}

static inline void print_nb(size_t n, size_t base);

_Static_assert(sizeof(t_block_header) % ALIGNMENT == 0, "block_header_t must "
							"be aligned");
_Static_assert(sizeof(t_free_block) % ALIGNMENT == 0, "free_block_t must be "
						      "aligned");
_Static_assert((ALIGNMENT & (ALIGNMENT - 1)) == 0, "ALIGNMENT must be a power "
						   "of 2");
_Static_assert(sizeof(size_t) == sizeof(void *), "size_t and void* must be "
						 "same size");

static t_heap g_heap = {.head = NULL, .free_list = NULL, .size = 0};

static inline void insert_block(t_free_block *block, t_free_block **free_list)
{
	block->next = NULL;
	if (block != *free_list)
		block->next = *free_list;
	if (*free_list != NULL)
		(*free_list)->prev = block;
	block->prev = NULL;
	*free_list = block;
}

static t_block *alloc_heap(void *addr, size_t size, t_free_block **free_list)
{
	t_block *head = mmap(addr, g_heap.size, PROT_READ | PROT_WRITE,
			     MAP_PRIVATE | MAP_ANON, -1, 0);
	if (head == MAP_FAILED)
		return NULL;
	head->size = size;
	set_alloc_block(head);
	t_block *footer = get_footer(head);
	footer->next = addr;
	set_alloc_block(footer);
	t_free_block *free_block = (t_free_block *)(head + 1);
	free_block->size = size - 2 * sizeof(t_block);
	set_free_block(free_block);
	get_footer(free_block)->size = free_block->size;
	insert_block(free_block, free_list);
	return head;
}

int malloc_init()
{
	g_heap.size = PAGE_SIZE;
	g_heap.head = alloc_heap(NULL, PAGE_SIZE, &g_heap.free_list);
	// g_heap.head = mmap(NULL, g_heap.size, PROT_READ | PROT_WRITE,
	// 		   MAP_PRIVATE | MAP_ANON, -1, 0);
	if (g_heap.head == MAP_FAILED)
		return 1;
	// set_alloc_block(g_heap.head);
	// set_alloc_block(
	//     (t_block *)((char *)g_heap.head + g_heap.size -
	//     sizeof(t_block)));
	// t_free_block *free_block = (t_free_block *)(g_heap.head + 1);
	// free_block->size = g_heap.size - 2 * sizeof(t_block);
	// free_block->prev = NULL;
	// free_block->next = NULL;
	// set_free_block(free_block);
	// get_footer(free_block)->size = free_block->size;
	// g_heap.free_list = free_block;
	return 0;
}

static inline void *expand_heap()
{
	t_block *head = alloc_heap(g_heap.head, PAGE_SIZE, &g_heap.free_list);
	if (head == NULL)
		return NULL;
	g_heap.head = head;
	write(1, "expand heap: ", 12);
	print_nb((uintptr_t)head, 16);
	write(1, "\n", 1);
	return head;
}

static inline t_free_block *find_free_block(size_t size)
{
	t_free_block *start = g_heap.free_list;
	while (start) {
		if (size <= block_size(start))
			return start;
		start = start->next;
	}
	if (expand_heap() == NULL)
		return NULL;
	return find_free_block(size);
};

static inline void *split_block(t_free_block *block, size_t size)
{
	size_t split_size = block_size(block) - size;
	block->size = split_size;

	t_block *alloc_block = next_block(block);
	alloc_block->size = size;
	set_alloc_block(alloc_block);
	get_footer(alloc_block)->size = alloc_block->size;

	set_free_block(block);
	get_footer(block)->size = block->size;

	return alloc_block;
}

static inline t_block_header *alloc_block(t_free_block *block, size_t size)
{
	if (block_size(block) - size >= MIN_BLOCK_SIZE)
		return split_block(block, size);
	set_alloc_block(block);
	get_footer(block)->size = block->size;
	if (block->next)
		block->next->prev = block->prev;
	if (block->prev)
		block->prev->next = block->next;
	else
		g_heap.free_list = block->next;
	return (t_block_header *)block;
}

void *malloc(size_t size)
{
	if (size == 0 || size > MAX_BLOCK_SIZE)
		return NULL;
	size = ALIGN(size + 2 * sizeof(t_block_header));
	size = size < MIN_BLOCK_SIZE ? MIN_BLOCK_SIZE : size;

	if (g_heap.head == NULL)
		if (malloc_init())
			return NULL;
	t_free_block *free_block = find_free_block(size);
	if (free_block == NULL)
		return NULL;
	return get_payload(alloc_block(free_block, size));
}

static inline void pop_block(t_free_block *block)
{
	if (g_heap.free_list == block)
		g_heap.free_list =
		    block->prev != NULL ? block->prev : block->next;
	if (block->next != NULL)
		block->next->prev = block->prev;
	if (block->prev != NULL)
		block->prev->next = block->next;
}

static inline void *coalesce(t_free_block *block)
{
	t_block_header *prev = prev_block(block);
	t_block_header *next = next_block(block);

	bool prev_free = is_free_block(prev);
	bool next_free = is_free_block(next);

	if (prev_free && !next_free) {
		prev = get_header_from_footer(prev);
		pop_block((t_free_block *)prev);
		prev->size = block_size(prev) + block_size(block);
		set_free_block(prev);
		block = (t_free_block *)prev;
	}
	if (!prev_free && next_free) {
		pop_block((t_free_block *)next);
		block->size = block_size(block) + block_size(next);
		set_free_block(block);
	}
	if (prev_free && next_free) {
		prev = get_header_from_footer(prev);
		pop_block((t_free_block *)prev);
		pop_block((t_free_block *)next);
		prev->size =
		    block_size(prev) + block_size(block) + block_size(next);
		set_free_block(prev);
		block = (t_free_block *)prev;
	}
	assert(block_size(block) <= g_heap.size - 2 * sizeof(t_block));

	insert_block(block, &g_heap.free_list);
	set_free_block(block);
	get_footer(block)->size = block->size;
	return block;
}

static inline bool is_valid_pointer(void *ptr)
{
	if (ptr == NULL || !IS_ALIGNED((size_t)ptr))
		return false;
	// t_block *start = g_heap.head;
	// while (start != NULL) {
	// 	if (ptr >= (void *)((char *)start + sizeof(t_block)) &&
	// 	    ptr < (void *)((char *)get_footer(start) - sizeof(t_block)))
	// 		return true;
	// 	start = get_footer(start)->next;
	// }
	// if (ptr <= (void *)g_heap.head ||
	//     ptr >=
	// 	(void *)((char *)g_heap.head + g_heap.size - sizeof(t_block)) ||
	//     g_heap.head == NULL)
	// 	return false;
	return true;
}

static inline bool is_valid_block(t_free_block *block, t_block *heap)
{
	if (is_free_block(block))
		return false;
	t_block *start = (t_block *)((char *)heap + sizeof(t_block));
	t_block *end = get_footer(heap);
	while (start != end) {
		if (start == (t_block *)block)
			return true;
		start = next_block(start);
	}
	return false;
}

static inline t_block *get_heap_from_ptr(void *ptr)
{
	t_block *start = g_heap.head;
	while (start != NULL) {
		if (ptr >= (void *)((char *)start + sizeof(t_block) * 2) &&
		    ptr <= (void *)((char *)get_footer(start) - MIN_BLOCK_SIZE +
				    sizeof(t_block)))
			return start;
		start = get_footer(start)->next;
	}
	return NULL;
};

static inline void free_heap(t_block *heap, t_free_block *block)
{
	if (block_size(block) < PAGE_SIZE - sizeof(t_block) * 2)
		return;
	if (block_size(heap) - sizeof(t_block) * 2 != block_size(block))
		return;
	t_block *prev = NULL;
	t_block *start = g_heap.head;
	while (start != heap) {
		prev = start;
		start = get_footer(start)->next;
	}
	if (prev == NULL) {
		g_heap.head = get_footer(heap)->next;
	} else {
		get_footer(prev)->next = get_footer(heap)->next;
	}

	write(1, "munmap()\n", 9);
	pop_block(block);
	munmap(heap, block_size(heap));
}

void free(void *ptr)
{
	// write(1, "free()\0", 7);
	// check if ptr is valid
	if (!is_valid_pointer(ptr)) {
		write(1, "valid ptr test failed: ", 23);
		print_nb((uintptr_t)ptr, 16);
		write(1, "\n", 1);
		return;
	}
	t_block *heap = get_heap_from_ptr(ptr);
	if (heap == NULL) {
		write(1, "heap find failed: ", 23);
		return;
	}
	t_free_block *block = (t_free_block *)get_header_from_payload(ptr);
	if (!is_valid_block(block, heap))
		return;
	block = coalesce(block);
	free_heap(heap, block);
	// if (block_size(block) == g_heap.size - 2 * sizeof(t_block_header))
	// 	free_heap();
}

static inline void print_nb(size_t n, size_t base)
{
	static char c[] = "0123456789abcdef";

	if (n >= base)
		print_nb(n / base, base);
	write(1, c + (n % base), 1);
}

void *realloc(void *ptr, size_t size)
{
	if (ptr == NULL)
		return malloc(size);
	else if (size == 0) {
		free(ptr);
		return NULL;
	}

	size = ALIGN(size);

	if (!is_valid_pointer(ptr))
		return NULL;
	t_block *block = get_header_from_payload(ptr);

	size_t old_size = block_size(block) - 2 * sizeof(t_block);
	if (is_free_block(block))
		return NULL;
	else if (old_size == size)
		return ptr;

	void *new_ptr = malloc(size);
	size = old_size > size ? size : old_size;
	for (size_t i = 0; i < size; i++) {
		((char *)new_ptr)[i] = ((char *)ptr)[i];
	}
	free(ptr);
	return new_ptr;
}

#define C_RESET "\x1b[0m"
#define C_RED "\x1b[31m"
#define C_GREEN "\x1b[32m"
#define C_YELLOW "\x1b[33m"
#define C_BLUE "\x1b[34m"
#define C_MAGENTA "\x1b[35m"
#define C_CYAN "\x1b[36m"
#define C_GRAY "\x1b[90m"

static inline void write_str(const char *s)
{
	size_t i = 0;
	while (s[i]) {
		i++;
	};
	write(1, s, i);
}

static inline void write_nbr(size_t n, size_t base)
{
	static char c[] = "0123456789abcdef";

	if (n >= base)
		print_nb(n / base, base);
	write(1, c + (n % base), 1);
}

static inline void write_ptr(void *ptr)
{
	write_str("0x");
	write_nbr((uintptr_t)ptr, 16);
}

#define color_swap(x) (x ? C_RED : C_GREEN)

static void dump_block(t_block *block)
{
	size_t size = block_size(block);
	int is_alloc = !is_free_block(block);

	write_str("  [");
	is_alloc ? write_str(C_RED) : write_str(C_GREEN);
	write_ptr(block);
	write_str(C_RESET "] HDR     size=");
	write_nbr(size, 10);

	write_str("\n");

	if (is_alloc) {
		void *payload = get_payload(block);

		write_str("  [");
		is_alloc ? write_str(C_RED) : write_str(C_GREEN);
		write_ptr(payload);
		write_str(C_RESET "] PAYLOAD size=");
		write_nbr(size - sizeof(t_block) * 2, 10);
		write_str("\n");
	} else {
		t_free_block *free_blk = (t_free_block *)block;
		write_str("  [");
		is_alloc ? write_str(C_RED) : write_str(C_GREEN);
		write_ptr(get_payload(block));
		write_str(C_RESET "] FREE    next=" C_GREEN);
		write_ptr(free_blk->next);
		write_str(C_RESET " | prev=" C_GREEN);
		write_ptr(free_blk->prev);
		write_str(C_RESET "\n");
	}

	t_block_header *ftr = get_footer(block);

	write_str("  [");
	!is_free_block(ftr) ? write_str(C_RED) : write_str(C_GREEN);
	write_ptr(ftr);
	write_str(C_RESET "] FTR     size=");
	write_nbr(block_size(ftr), 10);

	write_str("\n");
}

void dump_heap(void *head, int nb)
{
	t_block *footer;
	size_t heap_size = block_size(head);

	if (nb > 0)
		write_str("\n--------------------------------------------------"
			  "\n");

	write_str("HEAP #");
	write_nbr(nb, 10);
	write_str(" @ " C_CYAN);
	write_ptr(head);
	write_str(C_RESET "  size = ");
	write_nbr(heap_size, 10);
	write_str(" bytes\n\n");

	t_block *block = (t_block *)((char *)head + sizeof(t_block));
	t_block *end = get_footer(head);

	while (block < end) {
		dump_block(block);

		block = next_block(block);
		write_str("\n");
	}

	footer = get_footer(head);

	write_str("HEAP FOOTER next_heap=" C_CYAN);
	if (footer->next)
		write_ptr(footer->next);
	else
		write_str("NULL");
	write_str(C_RESET);
}

void show_alloc_mem()
{
	write_str("\n================ ALLOCATOR STATE ================\n\n");
	if (g_heap.head == NULL) {
		write(1, "HEAP : heap is empty\n", 21);
		write_str("\n\n================================================"
			  "=\n");
		return;
	}
	size_t i = 0;
	t_block *start = g_heap.head;
	while (start != NULL) {
		dump_heap(start, i++);
		start = get_footer(start)->next;
	}
	write_str("\n\n=================================================\n");
}
